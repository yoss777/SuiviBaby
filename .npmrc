# Résolution des peer dependencies comme en local : les fichiers de
# verrouillage du projet ont toujours été générés avec legacy-peer-deps=true
# (~/.npmrc du poste), alors que la CI et EAS faisaient `npm ci` sans.
# Conflit connu : expo-router 58 déclare @testing-library/react-native >= 14
# (peer optionnel) ; le projet reste en 13 jusqu'à la migration des tests vers
# l'API asynchrone de la v14. Retirer cette ligne après cette migration.
legacy-peer-deps=true
