{
  "name": "suivibaby",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest",
    "test:rules:run": "jest --runInBand --config jest.config.rules.js",
    "test:rules": "firebase emulators:exec --only firestore,storage 'npm run test:rules:run'",
    "test:functions": "npm --prefix functions test --",
    "test:all": "jest && npm --prefix functions test",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "eas-build-pre-install": "node ./scripts/easCopyFirebaseFiles.js",
    "update-app-config": "node ./scripts/updateAppConfig.mjs",
    "release:ios": "eas build --platform ios --profile production --non-interactive --auto-submit",
    "release:android": "eas build --local --platform android --profile production --non-interactive",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo/ui": "~58.0.28",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@gorhom/portal": "^1.0.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-firebase/app": "26.4.1",
    "@react-native-firebase/app-check": "26.4.1",
    "@react-native-google-signin/google-signin": "^17.0.0",
    "@react-native-picker/picker": "2.11.4",
    "@sentry/react-native": "~8.28.0",
    "@shopify/react-native-skia": "2.14.0",
    "dotenv": "^17.2.3",
    "expo": "^58.0.0",
    "expo-apple-authentication": "~58.0.2",
    "expo-asset": "~58.0.20",
    "expo-audio": "~58.0.11",
    "expo-blur": "~58.0.5",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-local-authentication": "~58.0.2",
    "expo-media-library": "~58.0.13",
    "expo-notifications": "~58.1.8",
    "expo-print": "~58.0.8",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.22",
    "expo-splash-screen": "~58.0.13",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "expo-widgets": "~58.0.28",
    "firebase": "^12.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-calendars": "^1.1314.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-pager-view": "9.0.7",
    "react-native-purchases": "10.16.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-sticky-parallax-header": "^1.1.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@react-native/jest-preset": "^0.88.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~58.0.4",
    "firebase-admin": "^13.6.1",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.14",
    "patch-package": "^8.0.1",
    "react-test-renderer": "^19.3.0",
    "typescript": "~6.0.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@gorhom/portal",
          "react-native-sticky-parallax-header"
        ],
        "listUnknownPackages": false
      }
    }
  },
  "private": true
}
