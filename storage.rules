rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function accessDoc(childId) {
      return firestore.get(
        /databases/(default)/documents/children/$(childId)/access/$(request.auth.uid)
      );
    }

    function hasAccess(childId) {
      return isSignedIn() &&
        firestore.exists(
          /databases/(default)/documents/children/$(childId)/access/$(request.auth.uid)
        );
    }

    function canWriteChildMedia(childId) {
      let access = accessDoc(childId).data;
      return hasAccess(childId) && (
        access.role in ['owner', 'admin'] ||
        ('canWriteEvents' in access && access.canWriteEvents == true)
      );
    }

    function isImageUpload() {
      return request.resource != null &&
        request.resource.contentType != null &&
        request.resource.contentType.matches('image/.*');
    }

    function isWithinSizeLimit() {
      return request.resource != null &&
        request.resource.size <= 5 * 1024 * 1024;
    }

    match /children/{childId}/jalons/{fileName} {
      // B5.S4 (REVERT 2026-05-27) : l'ancien `isNotSoftDeleted(childId)`
      // faisait un `firestore.get(children/{childId})` qui était bloqué
      // par les rules Firestore (`allow get: if isNotDeleted() &&
      // hasAccess(childId)`) → si la rule Firestore échouait pour
      // n'importe quelle raison, le storage `firestore.get` retournait
      // null → la fonction plantait silencieusement → allow read
      // retournait false → toutes les photos devenaient illisibles.
      // Vu en prod le 27 mai 2026 sur l'écran moments.
      //
      // La défense en profondeur sur le read est ABANDONNÉE car
      // redondante : B2.1 (softDeleteChild) wipe déjà les files
      // immédiatement via admin SDK, donc rien à lire après soft-delete.
      allow read: if hasAccess(childId);

      // Les fichiers de jalons sont immuables: nouvel upload ou suppression.
      allow create: if canWriteChildMedia(childId) &&
        isImageUpload() &&
        isWithinSizeLimit();
      allow update: if false;
      allow delete: if canWriteChildMedia(childId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
