{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      },
      "android": {
        "gradleCommand": ":app:assembleDebug"
      },
      "node": "22.23.4"
    },
    "development-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      },
      "ios": {
        "simulator": true
      },
      "node": "22.23.4"
    },
    "verify-simulator": {
      "environment": "production",
      "distribution": "internal",
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      },
      "ios": {
        "simulator": true,
        "image": "latest"
      },
      "node": "22.23.4"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      },
      "ios": {
        "resourceClass": "m-medium"
      },
      "environment": "production",
      "node": "22.23.4"
    },
    "staging": {
      "environment": "preview",
      "distribution": "internal",
      "env": {
        "APP_ENV": "staging",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      },
      "node": "22.23.4"
    },
    "production": {
      "environment": "production",
      "autoIncrement": true,
      "distribution": "store",
      "android": {
        "buildType": "app-bundle",
        "credentialsSource": "remote"
      },
      "ios": {
        "autoIncrement": true,
        "image": "latest"
      },
      "node": "22.23.4"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6773195663"
      },
      "android": {
        "serviceAccountKeyPath": "./secrets/google-play-service-account.json",
        "track": "alpha",
        "releaseStatus": "completed"
      }
    }
  }
}
