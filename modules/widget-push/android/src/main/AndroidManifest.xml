<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!-- Priorité 0 : passe avant le service d'expo-notifications (-1), à qui
         il rend tout message qui n'est pas destiné au widget. -->
    <service
      android:name="expo.modules.widgetpush.WidgetPushService"
      android:exported="false">
      <intent-filter android:priority="0">
        <action android:name="com.google.firebase.MESSAGING_EVENT" />
      </intent-filter>
    </service>
  </application>
</manifest>
