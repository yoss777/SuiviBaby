rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // HELPER FUNCTIONS
    // ============================================

    function isSignedIn() {
      return request.auth != null;
    }

    // Récupère le document d'accès de l'utilisateur pour cet enfant
    function getAccessDoc(childId) {
      return get(/databases/$(database)/documents/children/$(childId)/access/$(request.auth.uid));
    }

    // Vérifie si l'utilisateur a un accès (quel qu'il soit) à l'enfant
    function hasAccess(childId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/children/$(childId)/access/$(request.auth.uid));
    }

    // Vérifie si le document enfant existe
    function childExists(childId) {
      return exists(/databases/$(database)/documents/children/$(childId));
    }

    // Vérifie si l'utilisateur est owner selon le document enfant (bootstrap)
    function childDoc(childId) {
      return get(/databases/$(database)/documents/children/$(childId));
    }

    function isChildOwner(childId) {
      return isSignedIn() &&
        childExists(childId) &&
        get(/databases/$(database)/documents/children/$(childId)).data.ownerId == request.auth.uid;
    }

    // Vérifie si l'utilisateur est owner de l'enfant
    function isOwner(childId) {
      return hasAccess(childId) &&
        getAccessDoc(childId).data.role == 'owner';
    }

    function isAdmin(childId) {
      return hasAccess(childId) &&
        getAccessDoc(childId).data.role == 'admin';
    }

    // Access is granted to invitees only by Cloud Functions (acceptInvitationCF,
    // redeemShareCodeCF, Admin SDK). Clients can no longer write their own access
    // from an invitation or a share code (privilege escalation, 2026-11-02 audit).

    // Rôles et droits d'écriture sur les events (décision Q6, sprint 4.8) :
    //   owner / admin : créer et modifier les events, liker et commenter tout.
    //   contributor   : lire tous les events ; liker et commenter UNIQUEMENT
    //                   ceux qui portent des photos ; aucune écriture d'event.
    //   viewer        : lecture seule.
    // Le rôle seul décide : les anciens drapeaux canWriteEvents d'un document
    // d'accès ne donnent plus l'écriture d'events (un contributeur ou un
    // observateur ne peut pas se l'accorder par ce biais).
    function accessRole(childId) {
      return getAccessDoc(childId).data.role;
    }

    // Vérifie si l'utilisateur peut écrire des events (owner ou admin)
    function canWriteEvents(childId) {
      return hasAccess(childId) && accessRole(childId) in ['owner', 'admin'];
    }

    // L'event existe, appartient à cet enfant et porte au moins une photo.
    function isPhotoEventOf(childId, eventId) {
      return eventId is string &&
        exists(/databases/$(database)/documents/events/$(eventId)) &&
        get(/databases/$(database)/documents/events/$(eventId)).data.childId == childId &&
        get(/databases/$(database)/documents/events/$(eventId)).data.get('photos', []) is list &&
        get(/databases/$(database)/documents/events/$(eventId)).data.get('photos', []).size() > 0;
    }

    // Likes : owner/admin sur tout event ; contributor (ou drapeau explicite)
    // sur les events avec photos uniquement.
    function canWriteLikes(childId, eventId) {
      return hasAccess(childId) && (
        accessRole(childId) in ['owner', 'admin'] ||
        ((accessRole(childId) == 'contributor' ||
          getAccessDoc(childId).data.get('canWriteLikes', false) == true) &&
         isPhotoEventOf(childId, eventId)));
    }

    // Commentaires : mêmes règles que les likes.
    function canWriteComments(childId, eventId) {
      return hasAccess(childId) && (
        accessRole(childId) in ['owner', 'admin'] ||
        ((accessRole(childId) == 'contributor' ||
          getAccessDoc(childId).data.get('canWriteComments', false) == true) &&
         isPhotoEventOf(childId, eventId)));
    }

    // ============================================
    // COLLECTIONS PRINCIPALES
    // ============================================

    // Enfants - document principal
    match /children/{childId} {
      // Allergies connues (donnée de santé) : liste de 0 à 15 textes de 1 à 40
      // caractères. Les règles n'ont pas de boucle : chaque position est testée.
      function allergyAt(a, i) {
        return a.size() <= i || (a[i] is string && a[i].size() >= 1 && a[i].size() <= 40);
      }
      function validAllergies(a) {
        return a is list && a.size() <= 15 &&
          allergyAt(a, 0) && allergyAt(a, 1) && allergyAt(a, 2) && allergyAt(a, 3) &&
          allergyAt(a, 4) && allergyAt(a, 5) && allergyAt(a, 6) && allergyAt(a, 7) &&
          allergyAt(a, 8) && allergyAt(a, 9) && allergyAt(a, 10) && allergyAt(a, 11) &&
          allergyAt(a, 12) && allergyAt(a, 13) && allergyAt(a, 14);
      }

      // Helper: enfant non soft-deleted
      function isNotDeleted() {
        return !('deletedAt' in resource.data) || resource.data.deletedAt == null;
      }

      // Lecture d'un document spécifique (get) : accès via access subcollection uniquement
      // Bloqué si l'enfant est soft-deleted
      allow get: if isNotDeleted() && hasAccess(childId);

      // Liste (list) : désactivée — le pattern normal est user_child_access -> get children/{childId}
      // BabyContext utilise des listeners par document, pas de list query
      allow list: if false;

      // Création : l'utilisateur doit définir son propre UID comme ownerId
      // et fournir les champs requis avec les bons types
      allow create: if isSignedIn() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.birthDate is timestamp &&
        (!('allergies' in request.resource.data) || validAllergies(request.resource.data.allergies));

      // Modification : owner ou admin uniquement, bloqué si soft-deleted.
      // ownerId et deletedAt ne changent que côté serveur (transfert de
      // propriété, suppression) : sinon un admin pourrait se déclarer owner.
      // lastEventAt (dernier événement par catégorie, lu par les rappels et le
      // récap) est tenu par les Cloud Functions : un client qui l'écrit fausserait
      // les rappels de tous les membres.
      allow update: if isNotDeleted() && (
        isOwner(childId) || isAdmin(childId)
      ) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerId', 'ownerlessSince', 'deletedAt', 'lastEventAt']) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['allergies']) ||
          validAllergies(request.resource.data.allergies));

      // Suppression : uniquement via CF (purge RGPD) — plus de delete direct client
      allow delete: if false;

      // Sous-collection access : gestion des permissions
      match /access/{uid} {
        // Lecture : accès à son propre doc (id ou champ userId), ou owner pour voir les autres
        allow get: if isSignedIn() && (
          request.auth.uid == uid ||
          resource.data.userId == request.auth.uid ||
          isOwner(childId)
        );

        // Liste : tout user avec accès peut lister (pour voir les co-parents/contributeurs)
        allow list: if hasAccess(childId) || isChildOwner(childId);

        // Création : uniquement le bootstrap du créateur de l'enfant
        // (children.ownerId, role owner, son propre uid). Aucun accès pour un
        // AUTRE utilisateur n'est créé côté client, même par un owner : les
        // invités et co-parents reçoivent leur accès via Cloud Functions
        // (acceptInvitationCF, redeemShareCodeCF, Admin SDK).
        allow create: if uid == request.auth.uid &&
          isChildOwner(childId) &&
          request.resource.data.role == 'owner' &&
          request.resource.data.grantedBy is string &&
          request.resource.data.userId == uid;

        // Modification : le rôle (Parent = admin, Proche = contributor) et ses
        // drapeaux changent par la CF setMemberRole (propriétaire uniquement,
        // Admin SDK).
        // TRANSITION : l'écran « gérer les accès » des apps <= 1.0.9 met à jour
        // ce document directement ; sans cette branche, ces apps ne pourraient
        // plus changer un rôle tant qu'elles ne sont pas mises à jour. Limitée
        // au propriétaire : rôle admin/contributor/viewer (jamais owner),
        // drapeaux cohérents avec le rôle, aucun autre champ modifié, ni son
        // propre accès, ni celui d'un owner, ni celui du propriétaire principal.
        // À retirer quand app_config.minVersion > 1.0.9 (voir le plan, S12).
        allow update: if isOwner(childId) &&
          uid != request.auth.uid &&
          uid != childDoc(childId).data.ownerId &&
          resource.data.role != 'owner' &&
          request.resource.data.role in ['admin', 'contributor', 'viewer'] &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['role', 'canWriteEvents', 'canWriteLikes', 'canWriteComments']) &&
          request.resource.data.canWriteEvents == (request.resource.data.role == 'admin') &&
          request.resource.data.canWriteLikes == (request.resource.data.role in ['admin', 'contributor']) &&
          request.resource.data.canWriteComments == (request.resource.data.role in ['admin', 'contributor']);

        // Suppression : uniquement le owner (sauf son propre accès)
        allow delete: if isOwner(childId) && uid != request.auth.uid &&
          uid != childDoc(childId).data.ownerId;
      }

      // Session en cours partagée par le foyer (pour l'instant : la tétée,
      // document « nursing »). Donnée en cours comme un sommeil ou une
      // promenade : tout aidant de l'enfant la lit (accueil, widget) ; ceux qui
      // écrivent des événements la modifient. Une tétée terminée laisse un état
      // vide horodaté, jamais supprimé côté client.
      match /live/{sessionId} {
        function isNumOrNull(x) {
          return x == null || x is number;
        }
        function validLiveNursing(d) {
          return d.keys().hasOnly(['leftSeconds', 'rightSeconds', 'runningSide', 'runningSince',
              'startedAt', 'updatedAt', 'v', 'updatedBy', 'serverUpdatedAt']) &&
            d.leftSeconds is number && d.leftSeconds >= 0 && d.leftSeconds <= 86400 &&
            d.rightSeconds is number && d.rightSeconds >= 0 && d.rightSeconds <= 86400 &&
            (d.runningSide == null || d.runningSide in ['left', 'right']) &&
            isNumOrNull(d.runningSince) &&
            isNumOrNull(d.startedAt) &&
            d.updatedAt is number &&
            d.v == 1 &&
            d.updatedBy == request.auth.uid &&
            d.serverUpdatedAt == request.time;
        }

        allow get: if hasAccess(childId);
        allow list: if false;
        allow create, update: if sessionId == 'nursing' &&
          canWriteEvents(childId) &&
          validLiveNursing(request.resource.data);
        allow delete: if false;
      }
    }

    // Events (incluant pumping, tétées, couches, etc.)
    match /events/{eventId} {
      // Lecture : tous ceux qui ont accès à l'enfant
      allow read: if hasAccess(resource.data.childId);

      // Création : owner/admin + userId == auth.uid. `reported` est posé par le
      // serveur (modération) : un event ne naît pas déjà masqué.
      allow create: if canWriteEvents(request.resource.data.childId) &&
        request.resource.data.userId == request.auth.uid &&
        !('reported' in request.resource.data);

      // Modification : owner/admin uniquement. userId, childId, createdAt,
      // idempotencyKey et reported (modération) ne changent jamais côté client.
      allow update: if canWriteEvents(resource.data.childId) &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['userId', 'childId', 'createdAt', 'idempotencyKey', 'reported']);

      // Suppression : désactivée côté client — utiliser deleteEventCascade CF
      // pour garantir la suppression atomique des likes/comments associés.
      allow delete: if false;
    }

    // Likes sur les events
    match /eventLikes/{likeId} {
      // Get : vérifier accès à l'enfant
      allow get: if hasAccess(resource.data.childId);
      // List : accès autorisé uniquement aux documents rattachés à un enfant accessible.
      // Le client doit continuer à filtrer par childId/eventId pour rester performant.
      allow list: if isSignedIn()
        && resource.data.childId is string
        && hasAccess(resource.data.childId);

      // Création : owner/admin, ou contributor sur un event avec photos ; userId == auth.uid
      allow create: if canWriteLikes(request.resource.data.childId, request.resource.data.get('eventId', null)) &&
        request.resource.data.userId == request.auth.uid;

      // Suppression : son propre like OU owner/admin de l'enfant
      allow delete: if hasAccess(resource.data.childId) && (
        resource.data.userId == request.auth.uid ||
        canWriteEvents(resource.data.childId)
      );
    }

    // Commentaires sur les events
    match /eventComments/{commentId} {
      // Get : vérifier accès à l'enfant
      allow get: if hasAccess(resource.data.childId);
      // List : accès autorisé uniquement aux documents rattachés à un enfant accessible.
      // Le client doit continuer à filtrer par childId/eventId pour rester performant.
      allow list: if isSignedIn()
        && resource.data.childId is string
        && hasAccess(resource.data.childId);

      // Création : owner/admin, ou contributor sur un event avec photos ; userId == auth.uid
      allow create: if canWriteComments(request.resource.data.childId, request.resource.data.get('eventId', null)) &&
        request.resource.data.userId == request.auth.uid;

      // Modification : uniquement le texte de son propre commentaire ;
      // childId, eventId, userId et createdAt sont figés.
      allow update: if canWriteComments(resource.data.childId, resource.data.get('eventId', null)) &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['content', 'updatedAt', 'mentions']);

      // Suppression : son propre commentaire OU owner/admin de l'enfant
      allow delete: if (hasAccess(resource.data.childId) &&
        resource.data.userId == request.auth.uid) ||
        canWriteEvents(resource.data.childId);
    }

    match /reports/{reportId} {
      allow get: if isSignedIn() && resource.data.reporterUserId == request.auth.uid;
      allow list: if isSignedIn() &&
        request.query.limit <= 100 &&
        resource.data.reporterUserId == request.auth.uid;

      // B6.S1/S2/S3 — création client direct désactivée. Tout passe par
      // la CF submitContentReportCF (rate limit + exists check + anti
      // auto-report). La CF utilise admin SDK qui bypass rules.
      allow create: if false;

      allow update, delete: if false;
    }

    // ============================================
    // USER HIDDEN PHOTOS — per-user photo masking
    // ============================================

    match /user_hidden_photos/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // ============================================
    // INVITATIONS & PARTAGE
    // ============================================

    match /shareInvitations/{inviteId} {
      // Lecture (get) : parties concernées uniquement
      allow get: if isSignedIn() && (
        (resource.data.invitedEmail is string &&
         request.auth.token.email == resource.data.invitedEmail) ||
        request.auth.uid == resource.data.invitedUserId ||
        request.auth.uid == resource.data.inviterId ||
        (resource.data.inviterEmail is string &&
         request.auth.token.email == resource.data.inviterEmail)
      );

      // Liste : uniquement ses propres invitations (envoyées ou reçues)
      allow list: if isSignedIn() &&
        request.query.limit <= 200 && (
          resource.data.inviterId == request.auth.uid ||
          resource.data.invitedUserId == request.auth.uid ||
          resource.data.invitedEmail == request.auth.token.email
        );

      // Création : uniquement via createShareInvitation (quota co-parents,
      // champs validés). Un create direct contournait le quota du plan gratuit
      // et laissait l'inviteur fixer inviterEmail/childName librement.
      allow create: if false;

      // Mise à jour : l'invité peut seulement REFUSER une invitation en attente
      // (l'acceptation passe par acceptInvitationCF). Aucun autre champ
      // (childId, inviterId…) n'est modifiable.
      // TODO(M2) : exiger email_verified ici et en lecture, une fois la
      // vérification d'e-mail imposée à l'inscription.
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.invitedUserId ||
        request.auth.token.email == resource.data.invitedEmail
      ) &&
        resource.data.status == 'pending' &&
        request.resource.data.status == 'rejected' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
    }

    match /shareCodes/{code} {
      // Lecture : restreinte à créateur ou utilisateurs ayant déjà accès à
      // l'enfant. B1.2 — l'ancienne branche `(used == false && expiresAt > now)`
      // a été retirée car elle permettait à un attaquant authentifié de
      // bruteforcer des codes valides (1B combos) et de mapper des childIds.
      // L'unique chemin légitime de read pour un user externe est désormais
      // via la CF redeemShareCodeCF (admin SDK, bypass rules).
      // Un viewer/contributeur ne voit pas les codes actifs (il pourrait les
      // transmettre) : créateur, owner ou admin uniquement.
      allow read: if isSignedIn() && (
        resource.data.createdBy == request.auth.uid ||
        isOwner(resource.data.childId) ||
        isAdmin(resource.data.childId)
      );

      // Création : l'app ≥ 1.0.10 passe par la CF createShareCode (code
      // aléatoire serveur, 7 jours, un seul usage, créateur owner/admin
      // vérifié). TRANSITION : les apps ≤ 1.0.9 déjà installées créent encore
      // le code elles-mêmes ; sans cette branche, elles ne pourraient plus
      // partager un enfant jusqu'à leur mise à jour. Mêmes contraintes
      // qu'avant le sprint 12, plus la forme exacte du document (aucun champ
      // en plus, nom d'enfant borné). À retirer quand app_config.minVersion
      // > 1.0.9 (tâche datée dans le plan, S12).
      allow create: if isSignedIn() &&
        request.resource.data.keys().hasOnly(['code', 'childId', 'childName', 'createdBy', 'createdAt', 'expiresAt', 'used']) &&
        request.resource.data.childName is string &&
        request.resource.data.childName.size() <= 100 &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.code == code &&
        request.resource.data.used == false &&
        request.resource.data.expiresAt is timestamp &&
        request.resource.data.expiresAt <= request.time + duration.value(8, 'd') &&
        (isOwner(request.resource.data.childId) ||
         isAdmin(request.resource.data.childId) ||
         isChildOwner(request.resource.data.childId));

      // Mise à jour : interdite côté client. B1.2 — anciennement, le client
      // marquait `used:true` directement. Maintenant tout passe par la CF
      // redeemShareCodeCF (transactional, anti-race).
      allow update: if false;

      // Suppression : uniquement le créateur ou owner de l'enfant
      allow delete: if isSignedIn() && (
        resource.data.createdBy == request.auth.uid ||
        isOwner(resource.data.childId)
      );
    }

    // ============================================
    // INDEX D'ACCES UTILISATEUR -> ENFANT
    // ============================================

    match /user_child_access/{docId} {
      // Lecture : uniquement l'utilisateur concerné
      allow get: if isSignedIn() &&
        resource.data.userId == request.auth.uid;

      // Liste : uniquement ses propres accès (toutes les queries client filtrent sur userId)
      allow list: if isSignedIn() &&
        request.query.limit <= 200 &&
        resource.data.userId == request.auth.uid;

      // Création : uniquement pour soi-même, en tant que créateur de l'enfant
      // (bootstrap : isChildOwner regarde le doc enfant, car l'access doc n'est
      // pas encore visible par hasAccess) ou owner. L'entrée d'un AUTRE
      // utilisateur est écrite par acceptInvitationCF / redeemShareCodeCF
      // (Admin SDK) uniquement.
      // Mise à jour : owner ; userId et childId sont immuables.
      // L'id du doc est imposé ({userId}_{childId}).
      allow create: if isSignedIn() &&
        request.resource.data.userId is string &&
        request.resource.data.childId is string &&
        request.resource.data.userId == request.auth.uid &&
        docId == request.resource.data.userId + '_' + request.resource.data.childId &&
        (isOwner(request.resource.data.childId) ||
          isChildOwner(request.resource.data.childId));

      allow update: if isSignedIn() &&
        request.resource.data.userId is string &&
        request.resource.data.childId is string &&
        docId == request.resource.data.userId + '_' + request.resource.data.childId &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.childId == resource.data.childId &&
        (isOwner(request.resource.data.childId) ||
          (request.resource.data.userId == request.auth.uid &&
            isChildOwner(request.resource.data.childId)));

      // Suppression : owner ou l'utilisateur lui-même
      allow delete: if isSignedIn() &&
        (isOwner(resource.data.childId) ||
         resource.data.userId == request.auth.uid);
    }

    // ============================================
    // DONNÉES UTILISATEUR
    // ============================================

    match /users/{userId} {
      // M1 : un client ne peut poser ou modifier `pendingDeletion` qu'avec une
      // date de suppression à au moins 29 jours (sinon un appareil volé ou un
      // script déclencherait une purge immédiate). L'app actuelle passe par la
      // CF requestAccountDeletion ; l'app 1.0.8 écrit encore elle-même
      // { scheduledAt, deletionDate } en chaînes ISO UTC (toISOString), d'où
      // les deux formes acceptées (chaîne ISO ou Timestamp). Retirer le champ
      // (annulation) reste toujours permis.
      function two(n) {
        return n < 10 ? '0' + string(n) : string(n);
      }
      function isoAtLeast29Days(d) {
        let t = request.time + duration.value(29, 'd');
        return d is string &&
          d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$') &&
          d >= string(t.year()) + '-' + two(t.month()) + '-' + two(t.day()) + 'T' +
            two(t.hours()) + ':' + two(t.minutes()) + ':' + two(t.seconds());
      }
      function deletionDateOk(d) {
        return (d is timestamp && d >= request.time + duration.value(29, 'd')) ||
          isoAtLeast29Days(d);
      }
      function pendingDeletionAllowed() {
        return !('pendingDeletion' in request.resource.data) ||
          (resource != null && 'pendingDeletion' in resource.data &&
            request.resource.data.pendingDeletion == resource.data.pendingDeletion) ||
          (request.resource.data.pendingDeletion is map &&
            deletionDateOk(request.resource.data.pendingDeletion.get('deletionDate', null)));
      }
      // Chaque utilisateur peut uniquement lire/écrire son propre document
      allow read, delete: if isSignedIn() && request.auth.uid == userId;
      allow create, update: if isSignedIn() && request.auth.uid == userId &&
        pendingDeletionAllowed();
    }

    match /users_public/{userId} {
      // Données publiques minimales (nom uniquement — email retiré pour privacy)
      // get: tout user connecté peut lire un profil par uid (pour afficher le nom)
      // list: interdit (la CF findUserByEmail a été retirée : aucune recherche par e-mail)
      allow get: if isSignedIn();
      allow list: if false;
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    match /user_preferences/{userId} {
      // Chaque utilisateur peut uniquement lire/écrire ses propres préférences,
      // sauf healthDataConsent : preuve de consentement écrite par le serveur
      // (recordHealthConsent) ; le client ne peut ni la créer ni la modifier.
      // Transition : l'app ≤ 1.0.8 écrit encore elle-même un consentement
      // version "1.0" à l'inscription. On le tolère (sinon l'inscription
      // échoue) ; l'app actuelle exige la version serveur "2.2" et redemande.
      // Jamais par-dessus un consentement serveur.
      function isLegacyConsentWrite() {
        return request.resource.data.healthDataConsent.version == '1.0' &&
          !(resource != null && 'healthDataConsent' in resource.data &&
            resource.data.healthDataConsent.version != '1.0');
      }
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId &&
        (!('healthDataConsent' in request.resource.data) || isLegacyConsentWrite());
      allow update: if isSignedIn() && request.auth.uid == userId &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['healthDataConsent']) ||
          ('healthDataConsent' in request.resource.data && isLegacyConsentWrite()));
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Preuves de consentement (RGPD art. 7.1) : serveur uniquement, conservées
    // 5 ans après la suppression du compte (TTL expireAt posé par purgeUserData).
    match /consent_records/{recordId} {
      allow read, write: if false;
    }

    // Refresh token Sign in with Apple (révocation à la suppression du compte) :
    // serveur uniquement.
    match /apple_tokens/{userId} {
      allow read, write: if false;
    }

    // ============================================
    // NOTIFICATIONS
    // ============================================

    match /device_tokens/{tokenId} {
      // Lecture : l'utilisateur ne peut lire que ses propres tokens
      allow read: if isSignedIn() &&
        resource.data.userId == request.auth.uid;
      // Création : l'utilisateur ne peut créer que des tokens à son nom
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;
      // Mise à jour : son propre token, ou reprise d'un token posé par un
      // autre compte sur le même appareil. L'id du doc dérive du token Expo,
      // identique pour tous les comptes d'un téléphone : sans reprise, le
      // compte suivant n'était jamais enregistré (permission refusée) et
      // l'ancien continuait de recevoir ses notifications sur cet appareil.
      // Le token lui-même ne change pas ; écrire ce doc suppose de le
      // connaître, ce que seul l'appareil (ou son propriétaire) peut faire.
      allow update: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        (resource.data.userId == request.auth.uid ||
          request.resource.data.token == resource.data.token);
      // Suppression : uniquement ses propres tokens
      allow delete: if isSignedIn() &&
        resource.data.userId == request.auth.uid;
    }

    match /notification_history/{docId} {
      // Lecture seule pour l'utilisateur (l'écriture est faite par les Cloud Functions)
      allow read: if isSignedIn() &&
        resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /recap_history/{docId} {
      // Lecture seule pour l'utilisateur (l'écriture est faite par la CF sendWeeklyRecap)
      allow read: if isSignedIn() &&
        resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // ============================================
    // DEMANDES DE SUPPRESSION D'ENFANT
    // ============================================

    match /childDeletionRequests/{requestId} {
      // Lecture : uniquement les owners concernés (présents dans ownerIds array)
      // ownerIds est un array dénormalisé pour supporter les list queries (array-contains)
      allow read: if isSignedIn() &&
        request.auth.uid in resource.data.ownerIds;

      // Update : uniquement pour ajouter son propre uid à seenByUserIds (dismiss notification)
      allow update: if isSignedIn() &&
        request.auth.uid in resource.data.ownerIds &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenByUserIds']);

      // Création/Suppression : uniquement via Cloud Functions (serveur)
      allow create, delete: if false;
    }

    // ============================================
    // CLOUD FUNCTIONS DATA (server-side only)
    // ============================================

    // Rate limiting pour les Cloud Functions (géré côté serveur uniquement)
    match /rate_limits/{userId} {
      allow read, write: if false;
    }

    // Usage quotas (géré côté serveur, lecture autorisée pour l'utilisateur)
    match /usage_limits/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    // Subscriptions Premium (géré par RevenuCat webhooks côté serveur)
    // L'utilisateur peut lire son propre document, seul le serveur écrit
    match /subscriptions/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    // ============================================
    // SMART CONTENT — Tips (read-only for authenticated users)
    // ============================================

    match /tips/{tipId} {
      allow read: if isSignedIn();
      allow write: if false; // Admin-only via Firebase Console or scripts
    }

    // ============================================
    // SMART CONTENT — Milestone references (read-only for authenticated users)
    // ============================================

    match /milestones_ref/{milestoneId} {
      allow read: if isSignedIn();
      allow write: if false; // Admin-only via Firebase Console or scripts
    }

    // ============================================
    // SMART CONTENT — User content state (own data only)
    // ============================================

    match /user_content/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    // ============================================
    // PROMOTIONS — Read-only for authenticated users
    // ============================================

    match /promotions/{promoId} {
      allow read: if isSignedIn();
      allow write: if false; // Admin-only via Firebase Console
    }

    // ============================================
    // USER PROMOS — Promo tracking (own data only)
    // ============================================

    // Les champs de parrainage ne sont écrits que par le serveur
    // (ensureReferralCode / validateReferralCode, audit A2) : sinon un client
    // effaçait referredBy pour réutiliser un code, ou copiait le code d'un autre.
    match /user_promos/{userId} {
      function referralFieldsUntouchedOnCreate() {
        let d = request.resource.data;
        return !d.keys().hasAny(['referralCode', 'referredBy', 'referredAt'])
          && (!('referralCount' in d) || d.referralCount == 0)
          && (!('referralRewards' in d) || d.referralRewards.size() == 0);
      }
      function referralFieldsUntouchedOnUpdate() {
        return !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['referralCode', 'referredBy', 'referredAt', 'referralCount', 'referralRewards']);
      }
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId
        && referralFieldsUntouchedOnCreate();
      allow update: if isSignedIn() && request.auth.uid == userId
        && referralFieldsUntouchedOnUpdate();
      allow delete: if false;
    }

    // Code parrainage → propriétaire : serveur uniquement.
    match /referral_codes/{code} {
      allow read, write: if false;
    }

    // ============================================
    // APP CONFIG — Version check (read-only for authenticated users)
    // ============================================

    match /app_config/{docId} {
      allow read: if isSignedIn();
      allow write: if false; // Admin-only via Firebase Console
    }

    // ============================================
    // COLLECTION GROUP QUERIES
    // ============================================

    // Permet aux utilisateurs de requêter leurs propres accès via collectionGroup
    match /{path=**}/access/{docId} {
      // Un utilisateur peut lire ses propres documents d'accès
      // Soit via l'ID du document, soit via le champ userId
      allow read: if isSignedIn() && (
        request.auth.uid == docId ||
        resource.data.userId == request.auth.uid
      );
    }

    // ============================================
    // RÈGLE PAR DÉFAUT
    // ============================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
