+/**
+ * Redessine le widget à une date donnée (passage à 1 h, rappel dépassé,
+ * minuit…), sans réveil exact : alarme inexacte, sans permission. Ne rend rien.
+ * Props : atMs. Patch SuiviBaby.
+ */
+private fun ReadableMap.toPeekRefreshAt(converterContext: WidgetConverterContext): Emittable {
+  val atMs = doubleProp("atMs")?.toLong()
+  val context = converterContext.applicationContext
+  if (atMs != null && atMs > System.currentTimeMillis()) {
+    runCatching {
+      val manager = android.appwidget.AppWidgetManager.getInstance(context)
+      val alarms = context.getSystemService(Context.ALARM_SERVICE) as android.app.AlarmManager
+      context.resources.getStringArray(R.array.expo_widgets_names).forEachIndexed { index, name ->
+        val component = widgetProviderComponentName(context, name)
+        val ids = manager.getAppWidgetIds(component)
+        if (ids.isEmpty()) return@forEachIndexed
+        val intent = Intent(android.appwidget.AppWidgetManager.ACTION_APPWIDGET_UPDATE)
+          .setComponent(component)
+          .putExtra(android.appwidget.AppWidgetManager.EXTRA_APPWIDGET_IDS, ids)
+        val pending = android.app.PendingIntent.getBroadcast(
+          context,
+          0x5B10 + index,
+          intent,
+          android.app.PendingIntent.FLAG_UPDATE_CURRENT or android.app.PendingIntent.FLAG_IMMUTABLE
+        )
+        alarms.set(android.app.AlarmManager.RTC, atMs + 1000L, pending)
+      }
+    }
+  }
+  return EmittableSpacer().also { it.modifier = GlanceModifier.size(0.dp) }
+}
