+/**
+ * Chrono natif (RemoteViews Chronometer) : défile seul, sans rechargement.
+ * Props : startMs (début, ms epoch), pausedAtMs (figé à cette date, optionnel),
+ * color (#RRGGBB), fontSize (sp). Patch SuiviBaby.
+ */
+private fun ReadableMap.toPeekChronometer(converterContext: WidgetConverterContext): Emittable {
+  val props = propsMap() ?: return createErrorText("—")
+  val startMs = props.takeIf { it.hasKey("startMs") && !it.isNull("startMs") }?.getDouble("startMs")?.toLong()
+    ?: return createErrorText("—")
+  val pausedAtMs = props.takeIf { it.hasKey("pausedAtMs") && !it.isNull("pausedAtMs") }?.getDouble("pausedAtMs")?.toLong()
+  val color = props.takeIf { it.hasKey("color") && !it.isNull("color") }?.getString("color")
+  val fontSize = props.takeIf { it.hasKey("fontSize") && !it.isNull("fontSize") }?.getDouble("fontSize")?.toFloat() ?: 28f
+
+  val now = System.currentTimeMillis()
+  val elapsed = ((pausedAtMs ?: now) - startMs).coerceAtLeast(0L)
+  val base = android.os.SystemClock.elapsedRealtime() - elapsed
+  val viewId = R.id.expo_widgets_chronometer
+  val views = android.widget.RemoteViews(converterContext.applicationContext.packageName, R.layout.expo_widgets_chronometer).apply {
+    setChronometer(viewId, base, null, pausedAtMs == null)
+    setTextViewTextSize(viewId, android.util.TypedValue.COMPLEX_UNIT_SP, fontSize)
+    color?.let { runCatching { setTextColor(viewId, AndroidColor.parseColor(it)) } }
+  }
+  // EmittableAndroidRemoteViews est interne à Glance : instanciation par réflexion
+  // (règle -keep dans proguard-rules.pro).
+  return runCatching {
+    val cls = Class.forName("androidx.glance.appwidget.EmittableAndroidRemoteViews")
+    val emittable = cls.getDeclaredConstructor().newInstance() as Emittable
+    cls.getMethod("setRemoteViews", android.widget.RemoteViews::class.java).invoke(emittable, views)
+    emittable
+  }.getOrElse {
+    // Repli : durée figée au moment du rendu.
+    val total = elapsed / 1000
+    val text = if (total >= 3600) {
+      String.format("%d:%02d:%02d", total / 3600, (total % 3600) / 60, total % 60)
+    } else {
+      String.format("%d:%02d", total / 60, total % 60)
+    }
+    EmittableText().also { it.text = text }
+  }
+}
