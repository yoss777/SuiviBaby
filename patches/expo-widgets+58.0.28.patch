+  // (règle -keep dans proguard-rules.pro).
+  return runCatching {
+    val cls = Class.forName("androidx.glance.appwidget.EmittableAndroidRemoteViews")
+    val emittable = cls.getDeclaredConstructor().newInstance() as Emittable
+    cls.getMethod("setRemoteViews", android.widget.RemoteViews::class.java).invoke(emittable, views)
+    emittable
+  }.getOrElse {
+    // Repli : durée figée au moment du rendu.
+    android.util.Log.w("ExpoWidgets", "chrono natif indisponible, durée figée", it)
+    EmittableText().also { emittable -> emittable.text = frozenText }
+  }
+}
