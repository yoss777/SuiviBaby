+/**
+ * Durée écoulée à la minute (« 45 min », « 1h08 ») qui avance seule : TextClock
+ * réglé sur un fuseau fixe décalé de l'heure de début, si bien que l'« heure »
+ * affichée est le temps écoulé. Props : startMs, pattern (ex. "H'h'mm"),
+ * color, fontSize. Patch SuiviBaby.
+ */
+private fun ReadableMap.toPeekElapsedClock(converterContext: WidgetConverterContext): Emittable {
+  val startMs = doubleProp("startMs")?.toLong() ?: return createErrorText("—")
+  val pattern = stringProp("pattern") ?: "H'h'mm"
+  val color = stringProp("color")
+  val fontSize = doubleProp("fontSize")?.toFloat() ?: 28f
+
+  // Début arrondi à la minute ; décalage ramené dans [-12 h, +12 h[.
+  val dayMin = 24 * 60
+  val startMin = Math.floorMod(Math.round(startMs / 60000.0), dayMin.toLong()).toInt()
+  var offsetMin = -startMin
+  if (offsetMin < -12 * 60) offsetMin += dayMin
+  val sign = if (offsetMin < 0) "-" else "+"
+  val abs = Math.abs(offsetMin)
+  val zone = String.format("GMT%s%02d:%02d", sign, abs / 60, abs % 60)
+
+  val viewId = R.id.expo_widgets_elapsed
+  val views = android.widget.RemoteViews(converterContext.applicationContext.packageName, R.layout.expo_widgets_elapsed).apply {
+    setString(viewId, "setTimeZone", zone)
+    setCharSequence(viewId, "setFormat24Hour", pattern)
+    setCharSequence(viewId, "setFormat12Hour", pattern)
+    setTextViewTextSize(viewId, android.util.TypedValue.COMPLEX_UNIT_SP, fontSize)
+    color?.let { runCatching { setTextColor(viewId, AndroidColor.parseColor(it)) } }
+  }
+  return remoteViewsEmittable(views) {
+    val minutes = ((System.currentTimeMillis() - startMs) / 60000L).coerceAtLeast(0L)
+    if (minutes < 60) "$minutes min" else String.format("%dh%02d", minutes / 60, minutes % 60)
+  }
+}
